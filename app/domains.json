  "severity_rubric": {
    "critical": "imminent or actual injury, collision or fall; immediate response",
    "high": "unsafe interaction that could cause harm in seconds",
    "medium": "operational hazard needing attention this shift",
    "low": "unusual pattern worth review; no immediate risk",
    "modifiers": {
      "plus_one": [
        "duration_ge_3_segments",
        "repeats_ge_3_in_source",
        "second_look_confirms"
      ],
      "minus_one": ["neighbors_contradict", "only_one_weak_signal"],
      "clamp": ["low", "critical"]
    }
  },
