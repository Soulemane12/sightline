      "objectives": [
        {
          "id": "worker_vehicle_proximity",
          "name": "Worker / forklift proximity",
          "description": "A person within close range of a moving forklift.",
          "severity": "high",
          "rationale": "Workers and forklifts share aisles; primary person–vehicle risk in warehouse.",
          "detector": {
            "all_of": [
              { "primitive": "cooccur", "params": { "a": "person", "b": "forklift" } }
            ],
            "any_of": [
              {
                "primitive": "bbox_proximity",
                "params": {
                  "a": "person",
                  "b": "truck",
                  "max_gap_norm": 0.06,
                  "min_frames": 2
                }
              },
              {
                "primitive": "bbox_proximity",
                "params": {
                  "a": "person",
                  "b": "car",
                  "max_gap_norm": 0.06,
                  "min_frames": 2
                }
              },
              {
                "primitive": "caption_terms",
                "params": {
                  "any": ["near", "close", "beside", "approaching", "close to"]
                }
              },
              {
                "primitive": "caption_flag",
                "params": { "flag": "person_vehicle_proximity" }
              }
            ],
            "merge_gap_segments": 1
          },
          "semantic_probes": ["forklift moving close to a worker in an aisle"],
          "investigation_questions": [
            "Was the forklift moving?",
            "Did their paths intersect?",
            "For how many segments?",
            "Did anyone react?"
          ],
          "wording": {
            "title": "Worker / forklift proximity",
            "review_action": "Notify the floor lead; review aisle traffic plan"
          }
        },
