{
  "version": 1,
  "use_case": "dangerous_person_vehicle_interactions",
  "primary_source_hint": "sdg_warehouse_cam-2",
  "secondary_source_hint": "nyc_streets_cam-1",
  "yolo_classes_observed": [
    "person",
    "car",
    "traffic light",
    "truck",
    "bicycle",
    "bus",
    "handbag",
    "backpack",
    "motorcycle",
    "fire hydrant",
    "clock",
    "bench",
    "potted plant",
    "suitcase",
    "skateboard",
    "cell phone",
    "umbrella",
    "stop sign",
    "parking meter",
    "chair",
    "train",
    "airplane",
    "kite",
    "horse",
    "tv"
  ],
  "rule_vocabulary": [
    {
      "primitive": "entities_present",
      "params": {
        "entities": ["str"],
        "min_count": {"entity": "n"}
      },
      "needs": "yolo_or_caption",
      "passes_when": "every listed entity is present (YOLO class map or caption synonym)"
    },
    {
      "primitive": "cooccur",
      "params": { "a": "str", "b": "str" },
      "needs": "yolo_or_caption",
      "passes_when": "a and b both present in the segment"
    },
    {
      "primitive": "bbox_proximity",
      "params": {
        "a": "str",
        "b": "str",
        "max_gap_norm": "0.03-0.10",
        "min_frames": ">=2"
      },
      "needs": "yolo_sidecar",
      "passes_when": "closest box edge gap / frame diagonal <= max for >= min frames; boxes are pixel xyxy — normalize by frame diagonal at runtime"
    },
    {
      "primitive": "count_threshold",
      "params": {
        "entity": "str",
        "op": ">=|<=",
        "value": "number"
      },
      "needs": "yolo_or_caption_numbers",
      "passes_when": "count condition holds"
    },
    {
      "primitive": "persistence",
      "params": {
        "entity": "str",
        "min_segments": "int",
        "stationary": "bool"
      },
      "needs": "yolo_sidecar_across_segments",
      "passes_when": "entity stays in a similar box position for >= N consecutive segments"
    },
    {
      "primitive": "disappearance",
      "params": {
        "entity": "str",
        "present_segments": "int",
        "absent_segments": "int"
      },
      "needs": "yolo_across_segments",
      "passes_when": "present for N segments, then absent for M"
    },
    {
      "primitive": "caption_terms",
      "params": {
        "any": ["str"],
        "all": ["str"],
        "none": ["str"]
      },
      "needs": "caption",
      "passes_when": "case-insensitive term/regex match"
    },
    {
      "primitive": "caption_flag",
      "params": { "flag": "str" },
      "needs": "specialized_caption",
      "passes_when": "FLAGS: line contains the flag (only after Sightline prompt re-ingest)"
    },
    {
      "primitive": "semantic_probe",
      "params": {
        "query": "str",
        "min_similarity": "float"
      },
      "needs": "vss_search",
      "passes_when": "segment appears in probe results above threshold"
    },
    {
      "primitive": "time_window",
      "params": {
        "start": "HH:MM",
        "end": "HH:MM"
      },
      "needs": "wall_clock_metadata",
      "passes_when": "DISABLED: no capture wall-clock in index (upload_timestamp only). Engine should skip this primitive.",
      "available": false
    }
  ],
  "entity_map": {
